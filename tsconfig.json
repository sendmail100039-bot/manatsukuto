{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "modules/*/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "**/*.tsx"]
}
