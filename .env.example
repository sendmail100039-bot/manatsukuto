# ---------------------------------------------------------------
# Company Platform - environment variables
# Copy to .env and fill in. NEVER commit .env to GitHub.
# ---------------------------------------------------------------

# PostgreSQL connection (DB must NOT be exposed to the internet)
DATABASE_URL=postgres://platform:change-me@127.0.0.1:5432/platform

# 32+ random bytes, base64 or hex. Used for session signing and MFA secret encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_SECRET=replace-with-a-long-random-secret

# Public origin of the web app (used for CSRF origin checks & absolute links)
APP_ORIGIN=https://attendance.example.com

# Node environment: development | production
NODE_ENV=development

# Port for the Next.js server (reverse proxy / tunnel terminates HTTPS in front of it)
PORT=3000

# Optional: trust X-Forwarded-For from the reverse proxy (Caddy / Cloudflare Tunnel)
TRUST_PROXY=true

# Session lifetime (hours)
SESSION_TTL_HOURS=12

# Backup directory (worker / backup scripts)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Optional notification webhook (NotificationProvider). Leave blank to log only.
NOTIFY_WEBHOOK_URL=
